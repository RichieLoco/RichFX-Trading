<service>
  <id>RichFX-Bridge</id>
  <name>RichFX Bridge</name>
  <description>MT5 bridge — polls MT5 and writes state files</description>
  <executable>C:\Users\richi-rdp\AppData\Local\Programs\Python\Python312\python.exe</executable>
  <arguments>C:\__RichStuff\FX\trading_system\core\mt5_bridge.py --loop</arguments>
  <logpath>C:\Services\logs</logpath>
  <env name="PYTHONIOENCODING" value="utf-8"/>
  <log mode="roll-by-size">
    <sizeThreshold>10240</sizeThreshold>
    <keepFiles>5</keepFiles>
  </log>
  <onfailure action="restart" delay="10 sec"/>
  <serviceaccount>
    <username>.\richi-rdp</username>
    <password>YOUR_WINDOWS_PASSWORD</password>
    <allowservicelogon>true</allowservicelogon>
  </serviceaccount>
</service>